# Sentinel+ Environment Configuration Example
# Copy this file to .env and populate with your credentials

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Amazon Bedrock Model IDs
BEDROCK_ROUTER_MODEL=amazon.nova-lite-v1:0
BEDROCK_ORCHESTRATOR_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Sentinel+ Server Configuration
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_ENV=development

# Simulated Security Boundary
SENTINEL_AUTH_TOKEN=sentinel-secret-auth-token-2026
ALLOW_DESTRUCTIVE_ACTIONS=true
